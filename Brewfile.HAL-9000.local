tap "bro3886/tap", "https://github.com/BRO3886/homebrew-tap", trusted: true
# Microsoft Azure CLI 2.0
brew "azure-cli"
# Simple command-line tool for creating clusters on Amazon EKS
brew "eksctl"
# GitHub command-line tool
brew "gh"
# Kubernetes command-line interface
brew "kubernetes-cli"
# Mac App Store command-line interface
brew "mas"
# Command-line shell and scripting language
brew "powershell"
# Fast, native macOS Calendar CLI built on go-eventkit
brew "bro3886/tap/ical"
# Web browser focusing on privacy
cask "brave-browser"
# Terminal-based AI coding assistant
cask "claude-code@latest"
# Application window manager focusing on simplicity
cask "divvy"
# Client for the Dropbox cloud storage service
cask "dropbox"
# Desktop client for GitHub repositories
cask "github"
# Grammarly for desktop
cask "grammarly-desktop"
# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Screen and video recording software
cask "loom"
# Multi-platform web browser
cask "microsoft-edge"
# Knowledge base that works on top of a local folder of plain text Markdown files
cask "obsidian"
# Remote management solution
cask "royal-tsx"
# Team communication and collaboration software
cask "slack"
# Desktop client for TD Ameritrade trading platform
cask "thinkorswim"
# Voice-to-text dictation with AI-powered auto-editing
cask "wispr-flow"
